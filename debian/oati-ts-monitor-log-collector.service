[Unit]
Description=oati-ts-monitor log collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oati-ts-monitor
Group=oati-ts-monitor
WorkingDirectory=/var/lib/oati-ts-monitor
# Install/edit /etc/oati-ts-monitor/log_collector_config.json (see
# log_collector_config_example.json) and enable clickhouse there.
ExecStart=/usr/bin/oati-ts-monitor-log-collector \
  --config /etc/oati-ts-monitor/log_collector_config.json \
  --bind 0.0.0.0 \
  --port 9000 \
  --data-dir /var/lib/oati-ts-monitor/received_logs

Restart=always
RestartSec=2

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
