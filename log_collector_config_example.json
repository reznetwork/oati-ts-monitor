{
  "bind": "0.0.0.0",
  "port": 9000,
  "dataDir": "received_logs",
  "logLevel": "INFO",
  "maxUploadBytes": 16777216,
  "clickhouse": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8123,
    "database": "oati_logs",
    "user": "default",
    "password": "",
    "backfillOnStartup": true
  },
  "auth": {
    "enabled": false,
    "username": "admin",
    "passwordHash": "",
    "sessionHours": 12,
    "secureCookie": false
  },
  "viewer": {
    "activityGapMs": 120000,
    "metadataDb": "collector_metadata.sqlite3",
    "maxAnalysisDays": 90,
    "tileUrl": "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
    "tileAttribution": "© OpenStreetMap contributors"
  }
}
